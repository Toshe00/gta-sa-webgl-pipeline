{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "gta-sa-webgl-pipeline",
  "framework": null,
  "installCommand": "echo No dependencies to install",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
      { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self'; img-src 'none'; media-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
    ]},
    { "source": "/probes/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
      { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
    ]},
    { "source": "/probes/:name.wasm", "headers": [
      { "key": "Content-Type", "value": "application/wasm" }
    ]},
    { "source": "/probes/:name.data", "headers": [
      { "key": "Content-Type", "value": "application/octet-stream" }
    ]},
    { "source": "/probes/:name.wasm.br", "headers": [
      { "key": "Content-Type", "value": "application/wasm" },
      { "key": "Content-Encoding", "value": "br" }
    ]},
    { "source": "/probes/:name.txt.br", "headers": [
      { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
      { "key": "Content-Encoding", "value": "br" }
    ]}
  ]
}
